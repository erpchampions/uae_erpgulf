  {
   "fieldname": "section_details",
   "fieldtype": "Section Break",
   "label": "E-Invoice Details"
  },
  {
   "fieldname": "submit_to_fta",
   "fieldtype": "Check",
   "label": "Submit To FTA (Self-billed)",
   "depends_on": "eval:doc.reference_doctype==\"Purchase Invoice\"",
   "description": "Purchase Invoices are only sent to the ASP when this is ticked (self-billing)."
  },
  {
   "fieldname": "vat_category",
   "fieldtype": "Select",
   "label": "VAT Category",
   "options": "S - Standard rated\nZ - Zero rated\nE - Exempt from tax\nAE - VAT Reverse Charge\nO - Not subject to VAT\nN - Margin scheme",
   "description": "Invoice-level default. A line's Item Tax Template VAT Category wins over this."
  },
  {
   "fieldname": "vat_exemption_reason_code",
   "fieldtype": "Select",
   "label": "VAT Exemption Reason Code",
   "options": "\nDL8.46.1 - Certain financial services\nDL8.46.2 - Supply of residential units (lease or sale)\nDL8.46.3 - Bare land\nDL8.46.4 - Local passenger transport",
   "depends_on": "eval:doc.vat_category==\"E - Exempt from tax\""
  },
  {
   "fieldname": "rcm_nature_code",
   "fieldtype": "Select",
   "label": "RCM Nature Code",
   "options": "\nDL8.48.8.2 - Electronic Devices\nDL8.48.8.1 - Gold and Diamonds\nDL8.48.3.1 - Crude or refined oil\nDL8.48.3.2 - Unprocessed or processed natural gas\nDL8.48.3.3 - Pure hydrocarbons",
   "depends_on": "eval:doc.vat_category==\"AE - VAT Reverse Charge\""
  },
  {
   "fieldname": "invoice_transaction_type_code",
   "fieldtype": "Select",
   "label": "Invoice Transaction Type Code",
   "options": "\n1XXXXXX : Free trade zone transaction\nX1XXXXX : Deemed supply transaction\nXX1XXXX : Margin scheme transaction\nXXX1XXX : Summary tax invoice\nXXXX1XX : Continuous / repeated supply\nXXXXX1X : Disclosed agent billing\nXXXXXX1 : E-commerce supply\nXXXXXXX1 : Export transaction"
  },
  {
   "fieldname": "payment_means_codes",
   "fieldtype": "Select",
   "label": "Payment Means Codes",
   "options": "\n1 - Instrument not defined\n10 - Cash\n20 - Cheque\n30 - Credit transfer\n31 - Debit transfer\n42 - Payment to bank account\n48 - Bank card\n49 - Direct debit\n55 - Debit card\n58 - SEPA credit transfer",
   "depends_on": "eval:doc.reference_doctype==\"Purchase Invoice\""
  },
  {
   "fieldname": "column_break_details",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "frequency_billing_code_list",
   "fieldtype": "Select",
   "label": "Frequency Billing Code",
   "options": "\nDLY\nWKY\nQ15\nMTH\nQ45\nQ60\nQTR\nHYR\nYRL\nOTH"
  },
  {
   "fieldname": "invoice_note",
   "fieldtype": "Data",
   "label": "Invoice Note",
   "mandatory_depends_on": "eval:doc.frequency_billing_code_list==\"OTH\""
  },
  {
   "fieldname": "credit_note_reason_code",
   "fieldtype": "Select",
   "label": "Credit Note Reason Code",
   "options": "\nDL8.61.1.A-Cancellation\nDL8.61.1.B-Amendment\nDL8.61.1.C-Supplier\nDL8.61.1.D-Buyer\nDL8.61.1.E-Amounts\nVD-Void",
   "depends_on": "eval:doc.is_return"
  },
  {
   "fieldname": "return_against_for_uae_einvoice",
   "fieldtype": "Data",
   "label": "Original Invoice No. (not in ERPNext)",
   "depends_on": "eval:doc.is_return",
   "description": "For a credit note whose original invoice is not in this system (Company setting must allow it)."
  },
  {
   "fieldname": "skip_validation_for_credit_note",
